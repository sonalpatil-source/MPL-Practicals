; Program: Find the largest number in a byte array 

section .data     
; Byte array     
array db 11h, 59h, 33h, 22h, 44h 

            msg1 db 10, "ALP to find the largest number in an array", 10     
msg1_len equ $ - msg1 
         msg2 db 10, "The Array contains the elements: ", 10     
msg2_len equ $ - msg2 
msg3 db 10, 10, "The Largest number in the array is: ", 10     
msg3_len equ $ - msg3 

section .bss     
counter resb 1               
result  resb 4           

%macro write 2 
            mov rax, 1                   
mov rdi, 1                   
mov rsi, %1                  
mov rdx, %2                  
syscall 
%endmacro 

section .text global _start 
_start: 

write msg1, msg1_len     
write msg2, msg2_len 

mov byte [counter], 5        
mov rsi, array           

next: 
mov al, [rsi]                
push rsi                     
call disp                    
pop rsi                      
inc rsi                  
dec byte [counter]     
jnz next 

write msg3, msg3_len 

            mov byte [counter], 5        
mov rsi, array              
mov al, 0               

repeat: 
            cmp al, [rsi]                 
jg skip                      
mov al, [rsi]            

skip: 
            inc rsi                  
            dec byte [counter] 
            jnz repeat               


; Display largest element 

            call disp 

; Exit program 
         mov rax, 60                  
mov rdi, 0                  
syscall 

disp: 
            mov bl, al                ; store number in BL     
mov rdi,result            ; point RDI to result variable     
mov cx,02                 ; load count of rotation in CL (2 hex digits) up1: 
            rol bl,04                 ; rotate number left by 4 bits                           
mov al,bl                 ; move lower byte in dl     
and al,0Fh                ; get only LSB     
cmp al,09h                ; compare with 9h     
jg add_37                      
mov rdi, result            
mov cx, 2                
up1: 
rol bl, 4 
mov al, bl 
and al, 0Fh 
cmp al, 09h 
jg add_37 
add al, 30h 
jmp store 
add_37: 
add al, 37h
store: 
mov [rdi], al 
inc rdi 
dec cx 
jnz up1 
mov byte [rdi], 10 
write result, 3 
ret
